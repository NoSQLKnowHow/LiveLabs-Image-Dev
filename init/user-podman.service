[Unit]
Description=Podman Compose App
After=network-online.target sync-jl-notebooks.service
Wants=network-online.target sync-jl-notebooks.service

[Service]
Type=simple
Environment=PODMAN_SYSTEMD_UNIT=%n
Environment=PODMAN_USERNS=keep-id
Restart=always
TimeoutStartSec=420
TimeoutStopSec=420
WorkingDirectory=/home/opc/ingestion

ExecStartPre=/bin/bash -c 'install -d -m 0700 /home/opc/ingestion/runtime/logs'
ExecStartPre=/bin/bash -c '/home/opc/init/setenv.sh >> /home/opc/ingestion/runtime/logs/podman-compose.log 2>&1'

ExecStartPre=/bin/bash -c '/usr/local/bin/podman-compose down >> /home/opc/ingestion/runtime/logs/podman-compose.log 2>&1'
#ExecStartPre=/usr/bin/podman-compose down

# Start the compose app. Keep a durable log in addition to the user journal,
# including database-container initialization output.
ExecStart=/bin/bash -c 'install -d -m 0700 /home/opc/ingestion/runtime/logs; printf "\n===== podman-compose run started %s =====\n" "$$(date --iso-8601=seconds)" >> /home/opc/ingestion/runtime/logs/podman-compose.log; exec /usr/local/bin/podman-compose up >> /home/opc/ingestion/runtime/logs/podman-compose.log 2>&1'
ExecStop=/bin/bash -c '/usr/local/bin/podman-compose down >> /home/opc/ingestion/runtime/logs/podman-compose.log 2>&1'
#ExecStart=/usr/bin/podman-compose up

[Install]
WantedBy=default.target
